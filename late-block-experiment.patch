Subject: [PATCH] Add late block proposal experiment

---
 validator/client/late_block_experiment.go | 57 +++++++++++++++++++++++
 validator/client/propose.go               |  7 +++
 2 files changed, 64 insertions(+)
 create mode 100644 validator/client/late_block_experiment.go

diff --git a/validator/client/late_block_experiment.go b/validator/client/late_block_experiment.go
new file mode 100644
index 0000000..5fe6d2e
--- /dev/null
+++ b/validator/client/late_block_experiment.go
@@ -0,0 +1,57 @@
+package client
+
+import (
+	"context"
+	"os"
+	"strconv"
+	"time"
+
+	"github.com/OffchainLabs/prysm/v7/consensus-types/primitives"
+	"github.com/OffchainLabs/prysm/v7/time/slots"
+	"github.com/sirupsen/logrus"
+)
+
+const lateBlockDelayMillisEnv = "PRYSM_EXPERIMENT_LATE_BLOCK_DELAY_MS"
+
+func lateBlockDelay() (time.Duration, bool) {
+	value := os.Getenv(lateBlockDelayMillisEnv)
+	if value == "" {
+		return 0, false
+	}
+	millis, err := strconv.Atoi(value)
+	if err != nil || millis <= 0 {
+		return 0, false
+	}
+	return time.Duration(millis) * time.Millisecond, true
+}
+
+func (v *validator) waitForLateBlockExperiment(ctx context.Context, slot primitives.Slot, log *logrus.Entry) bool {
+	delay, enabled := lateBlockDelay()
+	if !enabled {
+		return true
+	}
+	slotStart, err := slots.StartTime(v.genesisTime, slot)
+	if err != nil {
+		log.WithError(err).WithField("slot", slot).Warn("Could not calculate slot start for late block experiment")
+		return true
+	}
+	target := slotStart.Add(delay)
+	wait := time.Until(target)
+	log.WithFields(logrus.Fields{
+		"slot":       slot,
+		"targetTime": target,
+		"delay":      delay,
+	}).Info("Late block experiment delaying block proposal")
+	if wait <= 0 {
+		return true
+	}
+	timer := time.NewTimer(wait)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		log.WithError(ctx.Err()).Warn("Late block experiment canceled before proposal")
+		return false
+	case <-timer.C:
+		return true
+	}
+}
diff --git a/validator/client/propose.go b/validator/client/propose.go
index 23713fd..d28b794 100644
--- a/validator/client/propose.go
+++ b/validator/client/propose.go
@@ -168,6 +168,13 @@ func (v *validator) ProposeBlock(ctx context.Context, slot primitives.Slot, pubK
 		}
 	}
 
+	if !v.waitForLateBlockExperiment(ctx, slot, log) {
+		if v.emitAccountMetrics {
+			ValidatorProposeFailVec.WithLabelValues(fmtKey).Inc()
+		}
+		return
+	}
+
 	blkResp, err := v.validatorClient.ProposeBeaconBlock(ctx, genericSignedBlock)
 	if err != nil {
 		log.WithField("slot", slot).WithError(err).Error("Failed to propose block")
